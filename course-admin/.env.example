# SPA app registration (Application (client) ID)
VITE_ENTRA_CLIENT_ID=REPLACE_WITH_YOUR_SPA_CLIENT_ID
# Directory (tenant) ID, not the tenant's sign-in email address
VITE_ENTRA_TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID
# Delegated scope exposed by the API app registration
VITE_API_SCOPE=api://REPLACE_WITH_YOUR_API_APP_CLIENT_ID/access_as_user
